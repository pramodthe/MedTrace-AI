{
  "name": "medtrace-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: radiology imaging stack + Medtrace clinical stack. One command to run everything in dev.",
  "scripts": {
    "dev": "concurrently -k -n rad-api,rad-web,med-api,med-web -c blue,cyan,magenta,green \"npm:dev:radiology-api\" \"npm:dev:radiology-web\" \"npm:dev:medtrace-api\" \"npm:dev:medtrace-web\"",
    "dev:radiology": "concurrently -k -n rad-api,rad-web -c blue,cyan \"npm:dev:radiology-api\" \"npm:dev:radiology-web\"",
    "dev:medtrace": "concurrently -k -n med-api,med-web -c magenta,green \"npm:dev:medtrace-api\" \"npm:dev:medtrace-web\"",
    "dev:radiology-api": "./.venv/bin/uvicorn app:app --app-dir services/radiology-api --host 127.0.0.1 --port 8000 --reload",
    "dev:radiology-web": "npm --prefix apps/radiology-web run dev",
    "dev:medtrace-api": "./.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:medtrace-web": "VITE_API_BASE_URL=http://localhost:8001 npm --prefix apps/medtrace-web run dev",
    "dev:streamlit": "./.venv/bin/streamlit run apps/streamlit_app.py --server.port 8501",
    "test:py": "./.venv/bin/pytest -m \"not integration\"",
    "build:web": "npm --prefix apps/radiology-web run build && npm --prefix apps/medtrace-web run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
